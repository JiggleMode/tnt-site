rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function owns(gameId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) && gameId in get(path).data.get('unlocked', []);
    }

    // Player profile + unlocks: players read their own; only admins (approving a payment) write.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }

    // UPI orders. The document id is the order code (also put in the UPI payment note).
    // Players create their own pending order; only admins approve or reject it.
    match /orders/{code} {
      allow create: if signedIn()
        && code.matches('^TNT[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid','gameId','amount','discountPercent','status','email','name','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.gameId is string && request.resource.data.gameId.size() < 40
        && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 1000
        && request.resource.data.discountPercent is int
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.createdAt == request.time
        && !owns(request.resource.data.gameId);
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decidedAt','decidedBy']);
      allow delete: if false;
    }

    // Play links for games not uploaded to Storage: only owners (and admins) can read them.
    match /gameLinks/{gameId} {
      allow read: if isAdmin() || (signedIn() && owns(gameId));
      allow write: if isAdmin();
    }

    // Play sessions (audit trail). A player can start a session only for a game they own,
    // and can only move their own counters forward by small steps.
    match /sessions/{sid} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','gameId','startedAt','lastSeenAt','endedAt','activeSeconds','inputs','device','tz'])
        && request.resource.data.activeSeconds == 0
        && request.resource.data.startedAt == request.time
        && owns(request.resource.data.gameId);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.endedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSeconds','inputs','lastSeenAt','endedAt'])
        && request.resource.data.activeSeconds is int
        && request.resource.data.activeSeconds >= resource.data.activeSeconds
        && request.resource.data.activeSeconds <= resource.data.activeSeconds + 60
        && request.resource.data.lastSeenAt == request.time;
      allow read: if isAdmin();
    }

    // Behaviour events (views, pay screen opened, etc). Players can only add their own.
    match /events/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type is string && request.resource.data.type.size() < 40
        && request.resource.data.at == request.time
        && request.resource.data.keys().size() <= 8;
      allow read: if isAdmin();
    }

    // Launch offer settings: everyone can read (to show prices), only admins change it.
    match /config/promo {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.percent is number
        && request.resource.data.percent >= 1 && request.resource.data.percent <= 90;
    }

    match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /payments/{id} { allow read, write: if isAdmin(); }
    match /gameStats/{id} { allow read, write: if isAdmin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
