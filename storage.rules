rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Game files: only players who own the game can download it.
    match /games/{file} {
      allow read: if request.auth != null
        && file.matches('[a-z0-9-]+[.]html')
        && file.split('[.]')[0] in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('unlocked', []);
      allow write: if false;
    }
    match /{all=**} { allow read, write: if false; }
  }
}
